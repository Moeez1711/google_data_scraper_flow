# ==============================================================================
# 1. SERVER CONFIGURATION (Set these in Render Dashboard -> Environment)
# ==============================================================================
GOOGLE_PLACES_API_KEY=your_places_api_key_here
PORT=10000

# CORS: Set to your Hostinger frontend URL (e.g. https://yourdomain.com) or * to allow all origins
CORS_ORIGIN=*

# Requests/second to Google Places API (default quota is 600/min for Text Search)
PLACES_RPS=5

# Estimated USD per 1000 Text Search requests - for the usage panel calculation only
PLACES_COST_PER_1000=35

# Hours to reuse identical Places responses (avoids paying twice for the same query)
PLACES_CACHE_TTL_HOURS=72

# Parallel website analyses
WEBSITE_CONCURRENCY=4

# Database storage path (defaults to data/leads.db; for Render persistent disk: /var/data/leads.db)
# DB_PATH=data/leads.db

# Google Sheets export: either path to service account JSON key OR raw JSON string
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# ==============================================================================
# 2. CLIENT CONFIGURATION (Used when building the frontend for Hostinger)
# ==============================================================================
# URL of your Render backend API (e.g. https://google-data-scraper-flow.onrender.com)
# Leave empty for local development (defaults to local proxy)
VITE_API_BASE_URL=

# Google Maps JavaScript API key (Restrict by HTTP referrer: https://yourdomain.com/*)
VITE_GOOGLE_MAPS_JS_KEY=
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
